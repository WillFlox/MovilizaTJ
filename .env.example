SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Cliente (Realtime en navegador) — mismos valores que arriba
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Google Places API (New) — solo servidor, búsqueda de destinos
# Habilitar "Places API (New)" en Google Cloud Console
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Automatización opcional — webhook para notificación de reportes nuevos
N8N_WEBHOOK_URL=https://your-n8n-domain/webhook/your-webhook-id

# Asistente de voz accesible — webhook que recibe audio + lat/lng y devuelve audio
N8N_VOICE_WEBHOOK_URL=https://your-n8n-domain/webhook/your-voice-webhook-id

# Visión computacional — webhook n8n que clasifica la foto y genera tipo, severidad y descripción
NEXT_PUBLIC_N8N_CLASIFICAR_FOTO_URL=https://your-n8n-domain/webhook/clasificar-foto
